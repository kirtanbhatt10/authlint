{
  "issuer": "https://login.strong.example",
  "authorization_endpoint": "https://login.strong.example/authorize",
  "token_endpoint": "https://login.strong.example/token",
  "userinfo_endpoint": "https://login.strong.example/userinfo",
  "jwks_uri": "https://login.strong.example/jwks.json",
