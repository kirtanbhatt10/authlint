{
  "issuer": "https://login.weak.example",
  "authorization_endpoint": "https://login.weak.example/authorize",
  "token_endpoint": "http://login.weak.example/token",
  "userinfo_endpoint": "https://login.weak.example/userinfo",
  "jwks_uri": "https://login.weak.example/jwks.json",
  "registration_endpoint": "https://login.weak.example/register",
  "scopes_supported": ["openid", "profile", "email"],
  "response_types_supported": ["code", "token", "id_token token"],
  "grant_types_supported": ["authorization_code", "implicit", "password", "refresh_token"],
  "subject_types_supported": ["public"],
  "id_token_signing_alg_values_supported": ["RS256", "none"],
  "token_endpoint_auth_methods_supported": ["client_secret_basic", "client_secret_post"],
  "code_challenge_methods_supported": ["plain", "S256"]
}
